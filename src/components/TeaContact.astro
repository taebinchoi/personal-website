interface Tea { id: string; label: string; flavor: string; tea: string; deep: string; light: string; href: string; show: string; copy?: boolean; }
interface Props { items: Tea[]; }
const { items } = Astro.props;

// 봉지 위아래 톱니 모양
const n = 10, w = 15;
let strip = 'M55 36';
for (let i = 0; i < n; i++) strip += ` L${55 + (i + .5) * w} 30 L${55 + (i + 1) * w} 36`;
strip += ' L205 58 L55 58 Z';
let body = 'M55 58 L205 58 L205 224';
for (let i = 0; i < n; i++) body += ` L${205 - (i + .5) * w} 230 L${205 - (i + 1) * w} 224`;
body += ' Z';

