---
<ul class="tea" data-tea>
  {items.map((t) => (
    <li class="item" id={`tea-${t.id}`} style={`--tea: ${t.tea}`}>
      <button type="button" class="open" aria-label={`Open ${t.label}`} aria-expanded="false" set:html={svgOf(t)} />
      <div class="txt">
        <span class="lbl" aria-hidden="true">{t.label}</span>
        {t.copy ? (
          <button type="button" class="addr" data-copy={t.show} data-text={t.show} tabindex="-1" aria-label={`Copy email address ${t.show}`}></button>
        ) : (
          <a class="addr" href={t.href} target="_blank" rel="noopener" data-text={t.show} tabindex="-1" aria-label={`${t.label} ${t.show}`}></a>
        )}
      </div>
    </li>
  ))}
</ul>
<p class="sr" aria-live="polite" data-tea-live></p>

<script>
  const root = document.querySelector<HTMLElement>('[data-tea]');
  if (root) {
    const m = new Date().getMonth() + 1;
    root.classList.add(m >= 11 || m <= 3 ? 'winter' : m >= 6 && m <= 9 ? 'summer' : 'mild');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const live = document.querySelector<HTMLElement>('[data-tea-live]')!;
    const KEY = 'tea-open';
    const opened = new Set<string>(JSON.parse(sessionStorage.getItem(KEY) || '[]'));

    const A = 'abcdefghijklmnopqrstuvwxyz0123456789';
    const pick = (ch: string) => (/[a-z0-9]/i.test(ch) ? A[(Math.random() * A.length) | 0] : ch);
    const timers = new WeakMap<HTMLElement, number>();
    const scramble = (el: HTMLElement, text: string) => {
      cancelAnimationFrame(timers.get(el) ?? 0);
      if (still) { el.textContent = text; return; }
      const t0 = performance.now(), dur = 260 + text.length * 22;
      let last = 0;
      const frame = (now: number) => {
        const p = (now - t0) / dur;
        if (p >= 1) { el.textContent = text; return; }
        if (now - last > 40) {
          last = now;
          const fixed = Math.floor(p * text.length);
          el.textContent = text.slice(0, fixed) + [...text.slice(fixed)].map(pick).join('');
        }
        timers.set(el, requestAnimationFrame(frame));
      };
      timers.set(el, requestAnimationFrame(frame));
    };

    const open = (li: HTMLElement, instant: boolean) => {
      if (li.classList.contains('on')) return;
      const btn = li.querySelector<HTMLButtonElement>('.open')!;
      const addr = li.querySelector<HTMLElement>('.addr')!;
      if (instant || still) li.classList.add('done');
      li.classList.add('on');
      btn.setAttribute('aria-expanded', 'true');
      addr.removeAttribute('tabindex');
      const text = addr.dataset.text!;
      if (instant || still) addr.textContent = text;
      else setTimeout(() => scramble(addr, text), 2700);
      opened.add(li.id);
      sessionStorage.setItem(KEY, JSON.stringify([...opened]));
    };

    root.querySelectorAll<HTMLElement>('.item').forEach((li) => {
      if (opened.has(li.id)) open(li, true);
      li.querySelector('.open')!.addEventListener('click', () => {
        open(li, false);
        // 열고 나면 키보드 사용자는 바로 주소로 이동할 수 있어요
      });
    });

    // Email: 누르면 주소 복사, 잠깐 Copied
    root.querySelectorAll<HTMLButtonElement>('button.addr[data-copy]').forEach((b) => {
      let back = 0;
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy!);
          clearTimeout(back);
          scramble(b, 'Copied');
          live.textContent = 'Copied';
          back = window.setTimeout(() => scramble(b, b.dataset.text!), 1600);
        } catch {
          location.href = 'mailto:' + b.dataset.copy;
        }
      });
    });
  }
</script>

<style is:global>
  .tea { list-style: none; margin: clamp(28px, 4vw, 48px) 0 0; padding: 0; display: flex; flex-direction: column; gap: clamp(4px, 1vw, 12px); }
  .tea .item { display: flex; align-items: center; gap: clamp(16px, 3vw, 40px); }
  .tea .open { all: unset; cursor: pointer; display: block; flex: none; border-radius: 8px; -webkit-tap-highlight-color: transparent; }
  .tea .open svg { display: block; overflow: visible; width: clamp(140px, 18vw, 240px); height: auto; }
  .tea .on .open { cursor: default; }
  .tea .open:focus-visible, .tea .addr:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .tea .txt { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 24px; row-gap: 6px; min-width: 0; }
  .tea .lbl { font-size: var(--fs-xl); font-weight: 700; line-height: 1; opacity: 0; clip-path: inset(0 100% -10% 0); }
  .tea .on .lbl { animation: tea-lblin .8s cubic-bezier(.7, 0, .2, 1) 1.9s forwards; }
  @keyframes tea-lblin { to { opacity: 1; clip-path: inset(0 0 -10% 0); } }
  .tea .addr {
    all: unset; display: inline-block; min-height: 1.5em; font-size: var(--fs-lead); font-weight: 700; font-stretch: 110%; color: var(--fg-2);
    white-space: nowrap; font-variant-numeric: tabular-nums; cursor: pointer; pointer-events: none; opacity: 0;
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat; background-position: 0 100%; background-size: 0% 1px;
    transition: opacity .2s, background-size .4s var(--ease);
  }
  .tea .on .addr { pointer-events: auto; opacity: 1; transition: opacity .2s 2.7s, background-size .4s var(--ease); }
  @media (hover: hover) { .tea .addr:hover { background-size: 100% 1px; color: var(--fg); } }
  /* 다시 들어왔을 때나 동작 줄이기 설정: 우려진 상태로 바로 */
  .tea .done *:not(.steam):not(.drop) { animation-duration: 0s !important; animation-delay: 0s !important; transition-duration: 0s !important; transition-delay: 0s !important; }
  .tea .done .steam, .tea .done .drop { animation-delay: 0s !important; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* 폰: 주소는 이름 아래 줄로 */
  @media (max-width: 640px) {
    .tea .txt { flex-direction: column; align-items: flex-start; row-gap: 4px; }
    /* 폰에서는 주소가 한 줄에 들어가도록 화면 너비에 맞춰 글씨를 살짝 줄여요 */
    .tea .open svg { width: clamp(112px, 33vw, 160px); }
    .tea .addr { font-size: clamp(11.5px, 3.3vw, 15px); }
  }

.tea .vb{transform-box:view-box}
.tea .pack{transition:transform .35s cubic-bezier(.2,.7,.2,1)}
@media (hover: hover) { .tea .item:hover .pack{transform:translateY(-6px)} }
.tea .on .pack{transform:none}
.tea .strip{transform-origin:55px 178px}
.tea .on .strip{animation:tea-tear .75s cubic-bezier(.4,0,.6,1) forwards}
@keyframes tea-tear{0%{transform:none;opacity:1}30%{transform:translate(-4px,-6px) rotate(-6deg);opacity:1}100%{transform:translate(-40px,-90px) rotate(-38deg);opacity:0}}
