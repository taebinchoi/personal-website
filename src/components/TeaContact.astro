---
// Contact의 티백 연출 (실사 이미지). 봉지를 누르면 절취선에서 뜯기고, 맑은 물 찻잔에 차가 번지며 우러나요.
// 계절: 11~3월에는 김이 나요. (6~9월 얼음 잔은 이미지가 생기면 추가)
interface Tea { id: string; label: string; flavor: string; brew: string; hue: string; dark?: string; href: string; show: string; copy?: boolean; }
interface Props { items: Tea[]; }
const { items } = Astro.props;
---
<ul class="tea" data-tea>
  {items.map((t) => (
    <li class="item" id={`tea-${t.id}`}>
      <button type="button" class="open" aria-label={`Open ${t.label}`} aria-expanded="false">
        <span class="stage">
          <span class="cup" aria-hidden="true">
            <img class="water" data-src="/media/tea/water-v2.webp" alt="" width="640" height="573" decoding="async" />
            <img class="brew" data-src={`/media/tea/${t.brew}-v2.webp`} alt="" width="640" height="573" decoding="async" />
            <span class="steam s1"></span><span class="steam s2"></span><span class="steam s3"></span>
          </span>
          <span class="pack" aria-hidden="true">
            <span class="strip"><img src="/media/tea/sachet-v3.webp" fetchpriority="high" alt="" width="309" height="600" decoding="async" /></span>
            <span class="body">
              <img src="/media/tea/sachet-v3.webp" alt="" width="309" height="600" decoding="async" />
              <img class="band" src="/media/tea/sachet-v3.webp" alt="" width="309" height="600" decoding="async" style={`filter: hue-rotate(${t.hue}) ${t.dark ?? ''}`} />
              <span class="name">{t.label}</span>
              <span class="flavor">{t.flavor}</span>
            </span>
          </span>
        </span>
      </button>
      <div class="txt">
        <span class="lbl" aria-hidden="true">{t.label}</span>
        {t.copy ? (
          <button type="button" class="addr" data-copy={t.show} data-text={t.show} tabindex="-1" aria-label={`Copy email address ${t.show}`}></button>
        ) : (
          <a class="addr" href={t.href} target="_blank" rel="noopener" data-text={t.show} tabindex="-1" aria-label={`${t.label} ${t.show}`}></a>
        )}
      </div>
    </li>
  ))}
</ul>
<p class="sr" aria-live="polite" data-tea-live></p>

<script>
  const root = document.querySelector<HTMLElement>('[data-tea]');
  if (root) {
    const m = new Date().getMonth() + 1;
    root.classList.add(m >= 11 || m <= 3 ? 'winter' : m >= 6 && m <= 9 ? 'summer' : 'mild');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const live = document.querySelector<HTMLElement>('[data-tea-live]')!;
    const KEY = 'tea-open';
    let saved: string[] = [];
    try { saved = JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch {}
    const opened = new Set<string>(saved);

    const A = 'abcdefghijklmnopqrstuvwxyz0123456789';
    const pick = (ch: string) => (/[a-z0-9]/i.test(ch) ? A[(Math.random() * A.length) | 0] : ch);
    const timers = new WeakMap<HTMLElement, number>();
    const scramble = (el: HTMLElement, text: string) => {
      cancelAnimationFrame(timers.get(el) ?? 0);
      if (still) { el.textContent = text; return; }
      const t0 = performance.now(), dur = 260 + text.length * 22;
      let last = 0;
      const frame = (now: number) => {
        const p = (now - t0) / dur;
        if (p >= 1) { el.textContent = text; return; }
        if (now - last > 40) {
          last = now;
          const fixed = Math.floor(p * text.length);
          el.textContent = text.slice(0, fixed) + [...text.slice(fixed)].map(pick).join('');
        }
        timers.set(el, requestAnimationFrame(frame));
      };
      timers.set(el, requestAnimationFrame(frame));
    };

    // 찻잔 사진은 봉지가 먼저 뜨도록 페이지가 다 열린 뒤에 받아요 (누르면 바로 받아요)
    const loadCups = (scope: ParentNode = root) => scope.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => { img.src = img.dataset.src!; img.removeAttribute('data-src'); });
    if (document.readyState === 'complete') setTimeout(() => loadCups(), 200);
    else addEventListener('load', () => setTimeout(() => loadCups(), 200), { once: true });

    const open = (li: HTMLElement, instant: boolean) => {
      loadCups(li);
      if (li.classList.contains('on')) return;
      const btn = li.querySelector<HTMLButtonElement>('.open')!;
      const addr = li.querySelector<HTMLElement>('.addr')!;
      if (instant || still) li.classList.add('done');
      li.classList.add('on');
      btn.setAttribute('aria-expanded', 'true');
      addr.removeAttribute('tabindex');
      const text = addr.dataset.text!;
      if (instant || still) addr.textContent = text;
      else setTimeout(() => scramble(addr, text), 2900);
      opened.add(li.id);
      try { sessionStorage.setItem(KEY, JSON.stringify([...opened])); } catch {}
    };

    root.querySelectorAll<HTMLElement>('.item').forEach((li) => {
      if (opened.has(li.id)) open(li, true);
      li.querySelector('.open')!.addEventListener('click', () => open(li, false));
    });

    root.querySelectorAll<HTMLButtonElement>('button.addr[data-copy]').forEach((b) => {
      let back = 0;
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy!);
          clearTimeout(back);
          scramble(b, 'Copied');
          live.textContent = 'Copied';
          back = window.setTimeout(() => scramble(b, b.dataset.text!), 1600);
        } catch {
          location.href = 'mailto:' + b.dataset.copy;
        }
      });
    });
  }
</script>

<style is:global>
  @property --steep { syntax: '<percentage>'; inherits: false; initial-value: -18%; }
  .tea { list-style: none; margin: clamp(28px, 4vw, 48px) 0 0; padding: 0; display: flex; flex-direction: column; gap: clamp(8px, 1.6vw, 20px); }
  .tea .item { display: flex; align-items: center; gap: clamp(16px, 3vw, 40px); }
  .tea .open { all: unset; cursor: pointer; display: block; flex: none; border-radius: 8px; -webkit-tap-highlight-color: transparent; }
  .tea .on .open { cursor: default; }
  .tea .open:focus-visible, .tea .addr:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }

  /* 무대: 찻잔 사진 비율 그대로 */
  .tea .stage { position: relative; display: block; width: clamp(150px, 22vw, 300px); aspect-ratio: 640 / 573; }
  .tea img { display: block; width: 100%; height: 100%; user-select: none; -webkit-user-drag: none; }

  /* 찻잔: 사진의 검정을 미리 투명하게 바꿔 둔 이미지라, 유리 너머로 사이트 배경이 은은하게 비쳐요 */
  .tea .cup { position: absolute; inset: 0; opacity: 0; transform: scale(.97); }
  .tea .cup img { position: absolute; inset: 0; }
  .tea .brew {
    --steep: -18%;
    -webkit-mask-image: radial-gradient(circle at 40% 49%, #000 var(--steep), transparent calc(var(--steep) + 22%));
            mask-image: radial-gradient(circle at 40% 49%, #000 var(--steep), transparent calc(var(--steep) + 22%));
  }
  .tea .on .cup { animation: tea-cup .9s cubic-bezier(.2, .7, .2, 1) 1s forwards; }
  @keyframes tea-cup { to { opacity: 1; transform: none; } }
  .tea .on .water { animation: tea-fade 1s ease 3.4s forwards; }
  @keyframes tea-fade { to { opacity: 0; } }
  .tea .on .brew { animation: tea-steep 2.8s cubic-bezier(.3, .2, .25, 1) 1.25s forwards; }
  @keyframes tea-steep { to { --steep: 130%; } }

  /* 김 (11~3월): 글씨나 태그를 가리지 않게 옅게 */
  .tea .steam { display: none; position: absolute; top: 2%; width: 16%; height: 22%; border-radius: 50%;
    background: radial-gradient(ellipse at 50% 60%, rgba(255, 255, 255, .55), transparent 70%); filter: blur(7px); opacity: 0; }
  .tea .s1 { left: 34%; } .tea .s2 { left: 46%; height: 26%; } .tea .s3 { left: 58%; }
  .tea.winter .on .steam { display: block; animation: tea-steam 4.6s ease-in-out infinite; }
  .tea.winter .on .s1 { animation-delay: 3.2s; } .tea.winter .on .s2 { animation-delay: 4.6s; } .tea.winter .on .s3 { animation-delay: 6s; }
  @keyframes tea-steam {
    0% { opacity: 0; transform: translate(0, 10%) scale(.8, .9); }
    35% { opacity: .38; }
    100% { opacity: 0; transform: translate(-8%, -55%) scale(1.25, 1.3); }
  }

  /* 봉지 */
  .tea .pack { position: absolute; top: 3%; bottom: 3%; left: 50%; aspect-ratio: 309 / 600; transform: translateX(-50%); container-type: inline-size; transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
  @media (hover: hover) { .tea .item:not(.on) .open:hover .pack { transform: translate(-50%, -3%); } }
  .tea .strip, .tea .body { position: absolute; inset: 0; }
  .tea .strip { clip-path: polygon(0% 0%, 100% 0%, 100.0% 7.95%, 92.9% 9.33%, 85.7% 8.07%, 78.6% 9.04%, 71.4% 7.93%, 64.3% 9.17%, 57.1% 7.91%, 50.0% 9.20%, 42.9% 7.92%, 35.7% 9.15%, 28.6% 8.11%, 21.4% 9.03%, 14.3% 8.16%, 7.1% 9.06%, 0.0% 8.03%); transform-origin: 3% 8.4%; }
  .tea .body { clip-path: polygon(0.0% 8.03%, 7.1% 9.06%, 14.3% 8.16%, 21.4% 9.03%, 28.6% 8.11%, 35.7% 9.15%, 42.9% 7.92%, 50.0% 9.20%, 57.1% 7.91%, 64.3% 9.17%, 71.4% 7.93%, 78.6% 9.04%, 85.7% 8.07%, 92.9% 9.33%, 100.0% 7.95%, 100% 100%, 0% 100%); transform-origin: 50% 100%; }
  .tea .body img { position: absolute; inset: 0; }
  .tea .band { clip-path: inset(66.4% 0 25.9% 0); }
  /* 종이 오른쪽 가장자리가 그늘져 좁아 보여서, 눈에 보이는 종이 가운데에 맞춰 살짝 왼쪽으로 */
  .tea .name, .tea .flavor { position: absolute; left: 0; right: 2.6%; text-align: center; color: #23201D; font-weight: 700; font-stretch: 110%; line-height: 1; }
  .tea .name { top: 37.5%; font-size: 13.5cqw; }
  .tea .flavor { top: 79.5%; font-size: 6.1cqw; letter-spacing: .12em; padding-left: .12em; color: #5E5850; }
  .tea .on .strip { animation: tea-tear .85s cubic-bezier(.4, 0, .6, 1) forwards; }
  @keyframes tea-tear {
    0% { transform: none; opacity: 1; }
    30% { transform: translate(-1%, -2%) rotate(-5deg); opacity: 1; }
    100% { transform: translate(-28%, -70%) rotate(-26deg); opacity: 0; }
  }
  .tea .on .body { animation: tea-drop .6s cubic-bezier(.5, 0, .75, 0) .4s forwards; }
  @keyframes tea-drop { to { transform: translateY(30%) rotate(3deg); opacity: 0; } }

  /* 글자 */
  .tea .txt { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 24px; row-gap: 6px; min-width: 0; }
  .tea .lbl { font-size: var(--fs-xl); font-weight: 700; line-height: 1; opacity: 0; clip-path: inset(0 100% -10% 0); }
  .tea .on .lbl { animation: tea-lblin .8s cubic-bezier(.7, 0, .2, 1) 1.9s forwards; }
  @keyframes tea-lblin { to { opacity: 1; clip-path: inset(0 0 -10% 0); } }
  .tea .addr {
    all: unset; display: inline-block; min-height: 1.5em; font-size: var(--fs-lead); font-weight: 700; font-stretch: 110%; color: var(--fg-2);
    white-space: nowrap; font-variant-numeric: tabular-nums; cursor: pointer; pointer-events: none; opacity: 0;
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat; background-position: 0 100%; background-size: 0% 1px;
    transition: opacity .2s, background-size .4s var(--ease);
  }
  .tea .on .addr { pointer-events: auto; opacity: 1; transition: opacity .2s 2.9s, background-size .4s var(--ease); }
  @media (hover: hover) { .tea .addr:hover { background-size: 100% 1px; color: var(--fg); } }

  /* 다시 들어왔을 때나 동작 줄이기 설정: 우려진 상태로 바로 */
  .tea .done *:not(.steam) { animation-duration: 0s !important; animation-delay: 0s !important; transition-duration: 0s !important; transition-delay: 0s !important; }
  .tea .done .steam { animation-delay: 0s !important; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* 폰: 주소는 이름 아래 줄, 한 줄에 들어가게 */
  @media (max-width: 640px) {
    .tea .stage { width: clamp(120px, 36vw, 170px); transition: width .55s cubic-bezier(.4, 0, .2, 1) .85s; }
    /* 뜯기 전에는 옆에 글자가 없으니 봉지를 크게, 뜯으면 찻잔 크기로 줄어요 */
    .tea .item:not(.on) .stage { width: min(68vw, 280px); }
    .tea .pack { left: 0; transform: none; }
    .tea .done .stage { transition: none; }
    .tea .txt { flex-direction: column; align-items: flex-start; row-gap: 4px; }
    .tea .addr { font-size: clamp(11.5px, 3.3vw, 15px); }
  }
</style>
