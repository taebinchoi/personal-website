---
// 화면에 보일 때만 재생, 소리 없음, 반복. 원래 비율 그대로.
interface Props { src: string; srcMobile?: string; poster?: string; width: number; height: number; label: string; }
const { src, srcMobile, poster, width, height, label } = Astro.props;
---
<video
  class="auto-video"
  autoplay
  muted
  loop
  playsinline
  disablepictureinpicture
  preload="auto"
  poster={poster}
  width={width}
  height={height}
  aria-label={label}
  style={`aspect-ratio: ${width} / ${height}`}
>
  {srcMobile && <source src={srcMobile} type="video/mp4" media="(max-width: 760px)" />}
  <source src={src} type="video/mp4" />
</video>

<style>
  .auto-video { width: 100%; height: auto; background: var(--surface); }
</style>

<script>
  // Safari 등은 muted 속성만으로 부족할 때가 있어 속성과 값을 모두 확실히 맞추고, 준비되면 다시 재생을 시도해요.
  const vids = document.querySelectorAll<HTMLVideoElement>('video.auto-video');
  const tryPlay = (v: HTMLVideoElement) => { v.muted = true; v.defaultMuted = true; v.play().catch(() => {}); };
  vids.forEach((v) => {
    v.setAttribute('muted', '');
    v.addEventListener('canplay', () => { if (v.dataset.visible !== '0') tryPlay(v); });
  });
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        const v = en.target as HTMLVideoElement;
        v.dataset.visible = en.isIntersecting ? '1' : '0';
        if (en.isIntersecting) tryPlay(v); else v.pause();
      }
    }, { threshold: 0.2 });
    vids.forEach((v) => io.observe(v));
  } else {
    vids.forEach(tryPlay);
  }
  addEventListener('pageshow', () => vids.forEach((v) => { if (v.dataset.visible !== '0') tryPlay(v); }));
</script>
