---
// 화면에 보일 때만 재생, 소리 없음, 반복. 원래 비율 그대로.
// 화면 근처에 온 영상만 받기 시작해요. 받는 동안은 정지 이미지(poster)가 보여요.
interface Props { src: string; srcMobile?: string; poster?: string; width: number; height: number; label: string; }
const { src, srcMobile, poster, width, height, label } = Astro.props;
---
<video
  class="auto-video"
  muted
  loop
  playsinline
  disablepictureinpicture
  preload="none"
  poster={poster}
  width={width}
  height={height}
  aria-label={label}
  style={`aspect-ratio: ${width} / ${height}`}
>
  {srcMobile && <source data-src={srcMobile} type="video/mp4" media="(max-width: 760px)" />}
  <source data-src={src} type="video/mp4" />
</video>

<style>
  .auto-video { width: 100%; height: auto; background: var(--surface); }
</style>

<script>
  const vids = [...document.querySelectorAll<HTMLVideoElement>('video.auto-video')];
  const tryPlay = (v: HTMLVideoElement) => { v.muted = true; v.defaultMuted = true; v.play().catch(() => {}); };
  const attach = (v: HTMLVideoElement) => {
    if (v.dataset.loaded) return;
    v.dataset.loaded = '1';
    v.setAttribute('muted', '');
    v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => { s.src = s.dataset.src!; });
    v.preload = 'auto';
    v.autoplay = true;
    v.addEventListener('canplay', () => { if (v.dataset.visible !== '0') tryPlay(v); });
    v.load();
  };

  const start = () => {
    if (!('IntersectionObserver' in window)) { vids.forEach((v) => { attach(v); tryPlay(v); }); return; }
    // 가까워지면 미리 받아 두고, 보이면 재생, 벗어나면 멈춤
    const near = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) attach(en.target as HTMLVideoElement); });
    }, { rootMargin: '600px 0px' });
    const seen = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        const v = en.target as HTMLVideoElement;
        v.dataset.visible = en.isIntersecting ? '1' : '0';
        if (en.isIntersecting) { attach(v); tryPlay(v); } else v.pause();
      });
    }, { threshold: 0.2 });
    vids.forEach((v) => { near.observe(v); seen.observe(v); });
  };

  // 화면에 보이는 영상은 바로 받기 시작해서 들어오자마자 재생돼요 (정지 이미지는 먼저 떠 있어요).
  start();
  addEventListener('pageshow', () => vids.forEach((v) => { if (v.dataset.loaded && v.dataset.visible !== '0') tryPlay(v); }));
</script>
