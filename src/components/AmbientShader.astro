---
// Contact 페이지 배경: 버건디·보라·남색이 아주 천천히 일렁이는 가벼운 WebGL 셰이더.
// 화면 오른쪽 아래에서 번지고 왼쪽 위로 갈수록 어둠에 녹아들어 글자를 가리지 않아요.
// WebGL이 안 되거나 '동작 줄이기' 설정이면 멈춘 그라디언트로 대신 보여요.
interface Props { origin?: 'bottom-right' | 'top-right'; ripple?: boolean; }
const { origin = 'bottom-right', ripple = false } = Astro.props;
---
<div class="ambient" aria-hidden="true" data-origin={origin} data-ripple={ripple ? "" : undefined}>
  <canvas></canvas>
</div>

<style>
  .ambient {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 55% at 92% 88%, rgba(91, 46, 158, .35), transparent 70%),
      radial-gradient(45% 45% at 70% 100%, rgba(122, 31, 61, .30), transparent 70%),
      var(--bg);
  }
  .ambient[data-origin='top-right'] {
    background:
      radial-gradient(60% 55% at 92% 12%, rgba(91, 46, 158, .35), transparent 70%),
      radial-gradient(45% 45% at 70% 0%, rgba(122, 31, 61, .30), transparent 70%),
      var(--bg);
  }
  canvas { width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.2s var(--ease); }
  canvas.on { opacity: 1; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.ambient canvas')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });

  if (gl) {
    const vs = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
    const fs = `precision mediump float;
uniform vec2 r;uniform float t;uniform vec2 o;uniform vec3 k;
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<4;i++){v+=a*n(p);p*=2.02;a*=.5;}return v;}
void main(){
  vec2 uv=gl_FragCoord.xy/r;vec2 q=uv*vec2(r.x/r.y,1.)*1.6;
  float s=t*.05;
  float age=t-k.z;float ring=0.;
  if(age>0.&&age<3.2){vec2 d=(uv-k.xy)*vec2(r.x/r.y,1.);float L=length(d);
    ring=exp(-pow((L-age*.42)*6.,2.))*pow(1.-age/3.2,1.6);
    q+=d/(L+.001)*ring*.12;}
  vec2 w=vec2(fbm(q+vec2(s,-s*.7)),fbm(q+vec2(-s*.6,s)+3.1));
  float f=fbm(q+1.8*w+s*.5);
  vec3 bg=vec3(.063,.063,.067);
  vec3 bur=vec3(.478,.122,.239),vio=vec3(.357,.180,.620),nav=vec3(.133,.208,.478);
  vec3 c=mix(nav,vio,smoothstep(.25,.75,f));c=mix(c,bur,smoothstep(.55,.95,w.x));
  float m=smoothstep(1.15,.05,distance(uv,o));
  m*=.55+.45*f;
  m=max(m,ring*(.6+.4*f));
  vec3 col=mix(bg,c,m*.55)+c*ring*.22;
  gl_FragColor=vec4(col,1.);
}`;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const pr = gl.createProgram()!;
    gl.attachShader(pr, sh(gl.VERTEX_SHADER, vs));
    gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(pr);
    if (gl.getProgramParameter(pr, gl.LINK_STATUS)) {
      gl.useProgram(pr);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(pr, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uR = gl.getUniformLocation(pr, 'r'), uT = gl.getUniformLocation(pr, 't');
      const top = canvas.parentElement!.dataset.origin === 'top-right';
      gl.uniform2f(gl.getUniformLocation(pr, 'o'), 1, top ? 1 : 0);

      // 해상도를 낮춰 그려도 흐릿한 색면이라 티가 안 나요. 그만큼 가벼워져요.
      // 폰에서 스크롤할 때 주소창이 줄었다 늘며 높이가 계속 바뀌어요. 그때마다 다시 만들면 버벅여서,
      // 너비가 바뀌거나 더 커질 때만 다시 만들어요.
      let lastW = 0, lastH = 0;
      const resize = () => {
        const s = 0.5;
        const w = innerWidth, h = Math.max(innerHeight, lastW === w ? lastH : 0);
        if (w === lastW && h === lastH) return;
        lastW = w; lastH = h;
        canvas.width = Math.max(1, Math.round(w * s));
        canvas.height = Math.max(1, Math.round(h * s));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uR, canvas.width, canvas.height);
      };
      resize();
      addEventListener('resize', resize);

      const t0 = performance.now();
      const uK = gl.getUniformLocation(pr, 'k');
      gl.uniform3f(uK, 0, 0, -100);

      // 숨은 반응: 빈 곳을 누르면 그 자리에서 물결이 한 번 퍼져요 (링크나 버튼은 제외)
      if (canvas.parentElement!.hasAttribute('data-ripple') && !reduce) {
        addEventListener('pointerdown', (e) => {
          if ((e.target as Element).closest('a, button, input, textarea, select, label')) return;
          gl.uniform3f(uK, e.clientX / innerWidth, 1 - e.clientY / innerHeight, (performance.now() - t0) / 1000);
        });
      }
      let last = 0, raf = 0;
      const draw = (now: number) => {
        raf = requestAnimationFrame(draw);
        if (now - last < 1000 / 30) return; // 30fps면 충분
        // 다른 움직임(Contact 티백 등)이 도는 동안은 잠깐 멈춰서 그쪽이 부드럽게 돌게 해요
        if (now < ((window as any).__calmUntil || 0)) return;
        last = now;
        gl.uniform1f(uT, (now - t0) / 1000);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };
      if (reduce) {
        gl.uniform1f(uT, 20); gl.drawArrays(gl.TRIANGLES, 0, 3);
      } else {
        raf = requestAnimationFrame(draw);
        document.addEventListener('visibilitychange', () => {
          cancelAnimationFrame(raf);
          if (!document.hidden) raf = requestAnimationFrame(draw);
        });
      }
      requestAnimationFrame(() => canvas.classList.add('on'));
    }
  }
</script>
