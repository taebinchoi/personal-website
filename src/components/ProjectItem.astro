---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import AutoVideo from './AutoVideo.astro';
import Alternate from './Alternate.astro';

// Portfolio의 작업과 Notes의 주제가 같이 써요. base: 링크 복사 때 쓸 페이지 주소
interface Props { project: CollectionEntry<'projects'> | CollectionEntry<'topics'>; base?: string; count?: number; }
const { project, base = '/', count = 0 } = Astro.props;
const d = project.data as CollectionEntry<'topics'>['data'];
const { Content } = await render(project);
const id = `detail-${project.id}`;
const facts = [
  ['Year', d.year], ['Tools', d.tools], ['Type', d.type], ['Role', d.role],
  ['Keywords', d.keywords], ['Notes', count > 0 ? String(count) : ''],
].filter(([, v]) => v);
const enParas = d.en ? d.en.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
const bilingual = enParas.length > 0;
---
<article class={d.titleEn ? "project alt-title" : "project"} id={project.id}>
  <div class="head">
    <h2>
      <button class="ptitle" type="button" aria-expanded="false" aria-controls={id}>
        <span class="lb">{d.titleEn ? <Alternate ko={d.title} en={d.titleEn} /> : d.title}</span>
        <svg class="plus" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 2v18M2 11h18" stroke="currentColor" stroke-width="2" /></svg>
      </button>
    </h2>
    {d.meta.length > 0 && <p class="meta">{d.meta.map((m) => <span>{m}</span>)}</p>}
  </div>

  {d.video && <AutoVideo {...d.video} />}
  {!d.video && d.cover && (
    <Image src={d.cover.src} alt={d.cover.alt} widths={[640, 1080, 1600, 2200]} sizes="(min-width: 900px) min(1680px, calc(100vw - 340px)), 100vw" class="cover" />
  )}

  <div class="drawer rest" id={id}>
    <div class="drawer-inner">
      <div class="detail" data-lang="ko">
        <div class="side-info">
          {facts.length > 0 && (
            <dl class="facts">
              {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
              {d.site && (<><dt>Site</dt><dd><a class="ul" href={d.site.href} target="_blank" rel="noopener">{d.site.label}</a></dd></>)}
            </dl>
          )}
        </div>

        <div class="body">
          {bilingual && (
            <div class="lang-switch" role="group" aria-label="Language">
              <button type="button" data-set="ko" aria-pressed="true"><span class="when-ko">한국어</span><span class="when-en">Korean</span></button>
              <span class="slash" aria-hidden="true">/</span>
              <button type="button" data-set="en" aria-pressed="false"><span class="when-ko">영어</span><span class="when-en">English</span></button>
            </div>
          )}
          <div class="text ko" lang="ko"><Content /></div>
          {bilingual && (
            <div class="text en" lang="en">{enParas.map((p) => <p>{p}</p>)}</div>
          )}
          {d.note && (
            <p class="note">
              <span class="ko" lang="ko">{d.note.ko}</span>
              {d.note.en && <span class="en" lang="en">{d.note.en}</span>}
            </p>
          )}
          {d.credits && <p class="credits">{d.credits}</p>}
          <slot />
          <p class="links">
            {d.links.map((l) => <a class="ul" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
            <button type="button" class="copy-link ul" data-id={project.id} data-base={base}><span class="cl-label">Copy link</span><span class="cl-done" aria-live="polite"></span></button>
          </p>
        </div>
        {d.stack.length > 0 && (
          <dl class="stack">
            {d.stack.map((s) => (<div><dt>{s.label}</dt><dd>{s.items}</dd></div>))}
          </dl>
        )}
      </div>
      {d.gallery.length > 0 && (
        <div class="gallery">
          {d.gallery.map((g) => (
            <figure class={g.wide ? 'shot wide' : 'shot'}>
              <Image src={g.src} alt={g.alt} decoding="async" fetchpriority="low" widths={[480, 800, 1200, 1600, 2200]} sizes={g.wide ? '(min-width: 900px) min(1680px, calc(100vw - 340px)), 100vw' : '(min-width: 900px) 40vw, 100vw'} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; gap: 20px; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px; }
  .ptitle {
    all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 18px;
    font: inherit; font-stretch: 110%; font-weight: 700; font-size: var(--fs-xl); line-height: 1.05; color: var(--fg);
  }
  .ptitle:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; }
  .lb {
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat;
    background-position: 0 100%; background-size: 0% 2px; transition: background-size .4s var(--ease);
  }
  .ptitle:hover .lb { background-size: 100% 2px; }
  .plus { flex: none; width: clamp(16px, 1.6vw, 22px); height: auto; transition: transform .4s var(--ease); }
  .ptitle[aria-expanded='true'] .plus { transform: rotate(45deg); }
  /* 한국어/영어가 번갈아 바뀌는 제목: 길이가 바뀌어도 + 가 흔들리지 않게 오른쪽 끝, 첫 줄 높이에 둬요 */
  .alt-title h2 { flex: 1 1 100%; }
  .alt-title .ptitle { display: flex; width: 100%; justify-content: space-between; align-items: flex-start; }
  .alt-title .plus { margin-top: .32em; }
  .alt-title .lb { background: none; }
  .alt-title .lb :global(.item) {
    justify-self: start;
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat;
    background-position: 0 100%; background-size: 0% 2px; transition: background-size .4s var(--ease);
  }
  .alt-title .ptitle:hover .lb :global(.item) { background-size: 100% 2px; }
  .meta { display: flex; gap: 20px; font-size: var(--fs-s); color: var(--fg-3); }
  .cover { width: 100%; height: auto; }

  .drawer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .55s var(--ease); }
  .drawer.open { grid-template-rows: 1fr; }
  .drawer-inner { overflow: hidden; min-height: 0; }
  .drawer.rest .drawer-inner { content-visibility: hidden; }
  .detail {
    padding-top: 32px; display: grid; gap: 32px 56px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) { .detail { grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); } }

  .side-info { display: flex; flex-direction: column; gap: 28px; }
  .facts { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 24px; align-content: start; }
  dt { color: var(--fg-3); }
  .stack {
    grid-column: 1 / -1; display: grid; gap: 20px 48px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 700px) { .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .stack dt { color: var(--fg); font-weight: 700; margin-bottom: 2px; }
  .stack dd { color: var(--fg-2); line-height: 1.6; }

  .body { display: flex; flex-direction: column; gap: 18px; color: var(--fg-2); line-height: 1.85; max-width: 760px; }
  .text { display: flex; flex-direction: column; gap: 1em; }
  .text :global(p) { margin: 0; }
  .note { color: var(--fg); }
  .credits { font-size: var(--fs-s); color: var(--fg-3); line-height: 1.6; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; }
  .links a { color: var(--fg); }
  .copy-link { all: unset; cursor: pointer; color: var(--fg-3); font-size: var(--fs-s); padding: 6px 0; }
  .copy-link:hover { color: var(--fg); }
  .copy-link:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .cl-done:not(:empty) { margin-left: 10px; color: var(--fg); }

  /* 언어 토글 */
  .lang-switch { display: flex; align-items: center; gap: 8px; font-size: var(--fs-s); color: var(--fg-4); }
  .lang-switch button { all: unset; cursor: pointer; padding: 6px 0; min-height: 32px; display: inline-flex; align-items: center; }
  .lang-switch button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .lang-switch button:hover { color: var(--fg-2); }
  .lang-switch button[aria-pressed='true'] { color: var(--fg); font-weight: 700; }
  .detail[data-lang='ko'] .when-en, .detail[data-lang='en'] .when-ko { display: none; }
  .detail[data-lang='ko'] .en, .detail[data-lang='en'] .ko { display: none; }
  .detail[data-lang='en'] .text.en { animation: fadein .35s var(--ease); }
  .detail[data-lang='ko'] .text.ko { animation: fadein .35s var(--ease); }
  @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }

  .gallery {
    margin-top: 40px; display: grid; gap: 16px; align-items: start;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 700px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .shot { margin: 0; }
  .shot.wide { grid-column: 1 / -1; }
  .shot :global(img) { width: 100%; height: auto; }
  /* 크기가 다른 화면 캡처는 같은 크기의 바탕 위에 잘리지 않게 놓아 줄을 맞춰요 */
  .shot:not(.wide) {
    aspect-ratio: 4 / 3; background: var(--surface); padding: clamp(14px, 2vw, 28px);
    display: flex; align-items: center; justify-content: center;
  }
  .shot:not(.wide) :global(img) { width: 100%; height: 100%; object-fit: contain; }
</style>

<script>
  // 펼치기 / 접기. 펼치면 주소 끝에 #작업이름 이 붙어서 그대로 공유할 수 있어요.
  // 버튼(+ → ×)은 바로 반응하고, 무거운 펼치기는 그다음 프레임에 시작해서 누른 순간 화면이 멈칫하지 않게 해요.
  const setOpen = (btn: HTMLButtonElement, open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    const drawer = document.getElementById(btn.getAttribute('aria-controls')!);
    if (!drawer) return;
    requestAnimationFrame(() => setTimeout(() => {
      if (open) drawer.classList.remove('rest');
      drawer.classList.toggle('open', open);
    }, 0));
    if (!open) {
      // 닫히는 애니메이션이 끝나면 안 보이는 내용은 그리지 않도록
      drawer.addEventListener('transitionend', () => {
        if (!drawer.classList.contains('open')) drawer.classList.add('rest');
      }, { once: true });
    }
  };
  document.querySelectorAll<HTMLButtonElement>('.ptitle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      setOpen(btn, open);
      const id = btn.closest('article')!.id;
      if (open) history.replaceState(null, '', '#' + id);
      else if (location.hash === '#' + id) history.replaceState(null, '', location.pathname);
    });
  });

  // #작업이름 으로 들어오면 그 작업을 펼치고 그 위치로 이동
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const art = document.getElementById(id);
    const btn = art?.querySelector<HTMLButtonElement>('.ptitle');
    if (!art || !btn) return;
    setOpen(btn, true);
    requestAnimationFrame(() => art.scrollIntoView({ block: 'start' }));
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);

  // Esc: 지금 보고 있는(또는 마지막으로 연) 작업을 닫고 제목으로 돌아가요
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const inside = (document.activeElement as HTMLElement | null)?.closest('article');
    const btn = inside?.querySelector<HTMLButtonElement>('.ptitle[aria-expanded="true"]')
      ?? [...document.querySelectorAll<HTMLButtonElement>('.ptitle[aria-expanded="true"]')].pop();
    if (!btn) return;
    btn.click();
    btn.focus({ preventScroll: true });
    const top = btn.getBoundingClientRect().top;
    if (top < 0 || top > innerHeight) btn.closest('article')!.scrollIntoView({ block: 'start' });
  });

  // 링크 복사
  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((b) => {
    b.addEventListener('click', async () => {
      const url = location.origin + (b.dataset.base || '/') + '#' + b.dataset.id;
      const done = b.querySelector('.cl-done')!;
      try { await navigator.clipboard.writeText(url); done.textContent = 'Copied'; }
      catch { done.textContent = url; }
      setTimeout(() => (done.textContent = ''), 2000);
    });
  });

  // 언어 토글: 기본은 적힌 그대로(한국어). 사용자가 직접 바꾼 경우에만 모든 작업에 같이 적용하고 기억해요.
  const KEY = 'lang';
  const applyLang = (lang: string) => {
    document.querySelectorAll<HTMLElement>('.lang-switch').forEach((sw) => {
      const detail = sw.closest<HTMLElement>('.detail')!;
      detail.dataset.lang = lang;
      sw.querySelectorAll<HTMLButtonElement>('button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.set === lang)));
    });
  };
  let saved: string | null = null;
  try { saved = localStorage.getItem(KEY); } catch {}
  if (saved === 'en') applyLang('en');
  document.querySelectorAll<HTMLButtonElement>('.lang-switch button').forEach((b) => {
    b.addEventListener('click', () => {
      const lang = b.dataset.set!;
      applyLang(lang);
      try { localStorage.setItem(KEY, lang); } catch {}
    });
  });
</script>
