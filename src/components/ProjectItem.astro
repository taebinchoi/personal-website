---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import AutoVideo from './AutoVideo.astro';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const id = `detail-${project.id}`;
const facts = [
  ['Year', d.year], ['Tools', d.tools], ['Type', d.type], ['Role', d.role],
].filter(([, v]) => v);
const enParas = d.en ? d.en.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
const bilingual = enParas.length > 0;
---
<article class="project" id={project.id}>
  <div class="head">
    <h2>
      <button class="ptitle" type="button" aria-expanded="false" aria-controls={id}>
        <span class="lb">{d.title}</span>
        <svg class="plus" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 2v18M2 11h18" stroke="currentColor" stroke-width="2" /></svg>
      </button>
    </h2>
    {d.meta.length > 0 && <p class="meta">{d.meta.map((m) => <span>{m}</span>)}</p>}
  </div>

  {d.video && <AutoVideo {...d.video} />}
  {!d.video && d.cover && (
    <Image src={d.cover.src} alt={d.cover.alt} widths={[640, 1080, 1600, 2200]} sizes="(min-width: 900px) min(1680px, calc(100vw - 340px)), 100vw" class="cover" />
  )}

  <div class="drawer" id={id}>
    <div class="drawer-inner">
      <div class="detail" data-lang="ko">
        <div class="side-info">
          {facts.length > 0 && (
            <dl class="facts">
              {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
            </dl>
          )}
          {d.stack.length > 0 && (
            <dl class="stack">
              {d.stack.map((s) => (<div><dt>{s.label}</dt><dd>{s.items}</dd></div>))}
            </dl>
          )}
        </div>

        <div class="body">
          {bilingual && (
            <div class="lang-switch" role="group" aria-label="Language">
              <button type="button" data-set="ko" aria-pressed="true"><span class="when-ko">한국어</span><span class="when-en">Korean</span></button>
              <span class="slash" aria-hidden="true">/</span>
              <button type="button" data-set="en" aria-pressed="false"><span class="when-ko">영어</span><span class="when-en">English</span></button>
            </div>
          )}
          <div class="text ko" lang="ko"><Content /></div>
          {bilingual && (
            <div class="text en" lang="en">{enParas.map((p) => <p>{p}</p>)}</div>
          )}
          {d.note && (
            <p class="note">
              <span class="ko" lang="ko">{d.note.ko}</span>
              {d.note.en && <span class="en" lang="en">{d.note.en}</span>}
            </p>
          )}
          {d.credits && <p class="credits">{d.credits}</p>}
          {d.links.length > 0 && (
            <p class="links">{d.links.map((l) => <a class="ul" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</p>
          )}
        </div>
      </div>
      {d.gallery.length > 0 && (
        <div class="gallery">
          {d.gallery.map((g) => (
            <Image src={g.src} alt={g.alt} class={g.wide ? 'wide' : undefined} widths={[480, 800, 1200, 1600, 2200]} sizes={g.wide ? '(min-width: 900px) min(1680px, calc(100vw - 340px)), 100vw' : '(min-width: 900px) 50vw, 100vw'} loading="lazy" />
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; gap: 20px; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px; }
  .ptitle {
    all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 18px;
    font: inherit; font-stretch: 110%; font-weight: 700; font-size: var(--fs-xl); line-height: 1.05; color: var(--fg);
  }
  .ptitle:focus-visible { outline: 2px solid var(--fg); outline-offset: 6px; }
  .lb {
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat;
    background-position: 0 100%; background-size: 0% 2px; transition: background-size .4s var(--ease);
  }
  .ptitle:hover .lb { background-size: 100% 2px; }
  .plus { flex: none; width: clamp(16px, 1.6vw, 22px); height: auto; transition: transform .4s var(--ease); }
  .ptitle[aria-expanded='true'] .plus { transform: rotate(45deg); }
  .meta { display: flex; gap: 20px; font-size: var(--fs-s); color: var(--fg-3); }
  .cover { width: 100%; height: auto; }

  .drawer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .55s var(--ease); }
  .drawer.open { grid-template-rows: 1fr; }
  .drawer-inner { overflow: hidden; min-height: 0; }
  .detail {
    padding-top: 32px; display: grid; gap: 32px 56px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) { .detail { grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); } }

  .side-info { display: flex; flex-direction: column; gap: 28px; }
  .facts { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 24px; align-content: start; }
  dt { color: var(--fg-3); }
  .stack { display: flex; flex-direction: column; gap: 14px; }
  .stack dt { color: var(--fg); font-weight: 700; margin-bottom: 2px; }
  .stack dd { color: var(--fg-2); line-height: 1.6; }

  .body { display: flex; flex-direction: column; gap: 18px; color: var(--fg-2); line-height: 1.85; max-width: 760px; }
  .text { display: flex; flex-direction: column; gap: 1em; }
  .text :global(p) { margin: 0; }
  .note { color: var(--fg); }
  .credits { font-size: var(--fs-s); color: var(--fg-3); line-height: 1.6; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; }
  .links a { color: var(--fg); }

  /* 언어 토글 */
  .lang-switch { display: flex; align-items: center; gap: 8px; font-size: var(--fs-s); color: var(--fg-4); }
  .lang-switch button { all: unset; cursor: pointer; padding: 6px 0; min-height: 32px; display: inline-flex; align-items: center; }
  .lang-switch button:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .lang-switch button:hover { color: var(--fg-2); }
  .lang-switch button[aria-pressed='true'] { color: var(--fg); font-weight: 700; }
  .detail[data-lang='ko'] .when-en, .detail[data-lang='en'] .when-ko { display: none; }
  .detail[data-lang='ko'] .en, .detail[data-lang='en'] .ko { display: none; }
  .detail[data-lang='en'] .text.en { animation: fadein .35s var(--ease); }
  .detail[data-lang='ko'] .text.ko { animation: fadein .35s var(--ease); }
  @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }

  .gallery {
    margin-top: 40px; display: grid; gap: 16px; align-items: start;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 700px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gallery :global(img) { width: 100%; height: auto; }
  .gallery :global(img.wide) { grid-column: 1 / -1; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ptitle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      document.getElementById(btn.getAttribute('aria-controls')!)?.classList.toggle('open', open);
    });
  });
  document.querySelectorAll<HTMLElement>('.lang-switch').forEach((sw) => {
    const detail = sw.closest<HTMLElement>('.detail')!;
    sw.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      b.addEventListener('click', () => {
        const lang = b.dataset.set!;
        detail.dataset.lang = lang;
        sw.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      });
    });
  });
</script>
