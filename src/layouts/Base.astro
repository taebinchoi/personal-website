---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site, nav } from '../site.config';

interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const marquee = [...projects.map((p) => p.data.title), 'HCI Notes'];
const nameChars = [...site.name];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#101011" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.title} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>
    try {
      if (sessionStorage.getItem('wipe') === '1') {
        sessionStorage.removeItem('wipe');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('wipe-in');
      }
    } catch (e) {}
  </script>
</head>
<body>
  <div class="wipe" aria-hidden="true"></div>

  <div class="rail" aria-hidden="true">
    <div class="rail-glow"><div class="rail-fill flow"></div></div>
    <div class="rail-line"><div class="rail-fill flow"></div></div>
  </div>

  <div class="shell">
    <header class="side">
      <a href="/" class="name" aria-label={`${site.name} 홈`}>
        {nameChars.map((ch) => (ch === ' ' ? <span class="gap" aria-hidden="true"></span> : <span aria-hidden="true">{ch}</span>))}
      </a>
      <nav aria-label="주요 메뉴">
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
                <span class="dot" aria-hidden="true"></span><span class="lb">{n.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="main">
      <div class="inner">
        <slot />

        <div class="marquee" aria-hidden="true">
          <div class="mq">
            {[...marquee, ...marquee].map((t) => <span>{t}</span>)}
          </div>
        </div>
        <footer class="foot">
          <span>© {site.year} {site.name}</span>
          <span class="foot-links">
            <a class="ul" href={site.links.instagram}>Instagram</a>
            <a class="ul" href={site.links.github}>GitHub</a>
          </span>
        </footer>
      </div>
    </main>
  </div>

  <script>
    // 오른쪽 스크롤 진행 막대
    const fills = document.querySelectorAll<HTMLElement>('.rail-fill');
    let raf = 0;
    const update = () => {
      raf = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, scrollY / max) : 1;
      const h = Math.max(0.04, p) * 100 + '%';
      fills.forEach((f) => (f.style.height = h));
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();

    // 페이지 전환: 색 띠가 덮고 지나감
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a || reduce.matches) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (a.target && a.target !== '_self') return;
      if (a.hasAttribute('download')) return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.search === location.search) return;
      if (/\.(pdf|mp4|jpg|png|zip)$/i.test(url.pathname)) return;
      e.preventDefault();
      try { sessionStorage.setItem('wipe', '1'); } catch (err) {}
      document.documentElement.classList.remove('wipe-in');
      document.documentElement.classList.add('wipe-go');
      setTimeout(() => { location.href = url.href; }, 430);
    });
    addEventListener('pageshow', (e) => {
      if (e.persisted) document.documentElement.classList.remove('wipe-go', 'wipe-in');
    });
  </script>
</body>
</html>

<style>
  /* 페이지 전환 띠 */
  .wipe {
    position: fixed; inset: 0; z-index: 50; pointer-events: none;
    background: linear-gradient(160deg, var(--burgundy), var(--violet) 55%, var(--navy));
    transform: translateX(-101%);
  }
  :global(html.wipe-go) .wipe { animation: wipe-cover .43s var(--ease-io) forwards; }
  :global(html.wipe-in) .wipe { transform: none; animation: wipe-leave .55s var(--ease-io) .05s forwards; }
  @keyframes wipe-cover { from { transform: translateX(-101%); } to { transform: none; } }
  @keyframes wipe-leave { from { transform: none; } to { transform: translateX(101%); } }

  /* 스크롤 막대 */
  .rail { position: fixed; top: 0; right: 0; bottom: 0; z-index: 40; pointer-events: none; }
  .rail-line { position: absolute; top: 0; right: 0; bottom: 0; width: var(--rail); background: #1A1A1D; }
  .rail-glow {
    position: absolute; top: 0; right: 0; bottom: 0; width: 56px; opacity: .55;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000); mask-image: linear-gradient(90deg, transparent, #000);
  }
  .rail-glow .rail-fill { filter: blur(18px); }
  .rail-fill { position: absolute; top: 0; left: 0; right: 0; height: 4%; background-image: var(--blend); }
  .flow { background-size: 100% 300%; animation: flow 6s linear infinite; }
  @keyframes flow { from { background-position: 0 0%; } to { background-position: 0 100%; } }

  /* 전체 틀 */
  .shell { display: grid; grid-template-columns: 1fr; min-height: 100vh; }
  .side {
    position: sticky; top: 0; z-index: 30;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px;
    padding: 14px var(--pad-x);
    background: rgba(16, 16, 17, .92);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .name {
    font-size: var(--fs-l); line-height: 1.1; text-decoration: none; font-weight: 400;
    display: inline-flex; align-items: baseline; min-height: 44px; align-items: center;
  }
  .name span { display: inline-block; transition: font-weight .25s; }
  .name .gap { width: .3em; }
  @media (hover: hover) {
    .name span:hover { font-weight: 900; }
    .name span:hover + span, .name span:has(+ span:hover) { font-weight: 700; }
    .name span:hover + span + span, .name span:has(+ span + span:hover) { font-weight: 550; }
  }
  nav ul { list-style: none; margin: 0; padding: 0 0 0 14px; display: flex; gap: 0 18px; flex-wrap: wrap; }
  @media (max-width: 899px) {
    .shell { align-content: start; }
    .side { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 0; padding-top: 10px; padding-bottom: 4px; }
    .name { min-height: 40px; }
    nav ul { padding-left: 0; }
    .dot { display: none; }
  }
  nav a {
    position: relative; display: flex; align-items: center; min-height: 44px;
    text-decoration: none; font-weight: 700; font-size: var(--fs-m); color: var(--fg-4);
  }
  nav a[aria-current='page'] { color: var(--fg); }
  .dot { position: absolute; left: -14px; top: 50%; margin-top: -3px; width: 6px; height: 6px; background: transparent; }
  nav a[aria-current='page'] .dot { background: var(--fg); }
  .lb {
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat;
    background-position: 0 100%; background-size: 0% 2px; transition: background-size .4s var(--ease); padding-bottom: 2px;
  }
  nav a:hover .lb { background-size: 100% 2px; }

  .main { min-width: 0; padding: 0 calc(var(--pad-x) + var(--rail)) 48px var(--pad-x); }
  .inner { max-width: clamp(1120px, 68vw, 1680px); }

  @media (min-width: 900px) {
    .shell { grid-template-columns: var(--sidebar) minmax(0, 1fr); }
    .side {
      height: 100vh; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; justify-content: flex-start;
      gap: 48px; padding: 28px 32px; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none;
    }
    .name { font-size: 22px; }
    nav ul { flex-direction: column; gap: 2px; padding-left: 0; }
    nav a { font-size: 22px; }
    .main { padding-top: 28px; padding-left: clamp(20px, 3vw, 48px); }
  }
  @media (max-width: 899px) {
    :global(:root) { --rail: 3px; }
    .rail-glow { display: none; }
  }

  /* 흐르는 글자 */
  .marquee { overflow: hidden; margin-top: clamp(96px, 14vw, 160px); padding: 20px 0; }
  .mq {
    display: flex; align-items: baseline; gap: 56px; width: max-content; white-space: nowrap;
    font-size: var(--fs-xl); color: var(--fg-4); animation: mq 40s linear infinite;
  }
  @keyframes mq { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .foot {
    padding-top: 28px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    font-size: var(--fs-s); color: var(--fg-3);
  }
  .foot-links { display: flex; gap: 20px; }
</style>
