---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import AmbientShader from '../components/AmbientShader.astro';
import TeaContact from '../components/TeaContact.astro';

// 티백 세 개: 차 이름, 우린 찻잔 사진(brew), 봉지 띠 색(hue)은 여기서 바꿔요
const teas = [
  { id: 'email', label: 'Email', flavor: 'HIBISCUS', brew: 'hibiscus', hue: '0deg',
    href: site.links.email, show: site.links.email.replace('mailto:', ''), copy: true },
  { id: 'instagram', label: 'Instagram', flavor: 'LAVENDER', brew: 'lavender', hue: '-95deg', dark: 'saturate(1.1)',
    href: site.links.instagram, show: '@' + site.links.instagram.split('/').filter(Boolean).pop() },
  { id: 'github', label: 'GitHub', flavor: 'BLACKCURRANT', brew: 'blackcurrant', hue: '-35deg', dark: 'brightness(.7)',
    href: site.links.github, show: site.links.github.replace('https://', '') },
].filter((t) => t.href);
---
<Base title="Contact">
  <link slot="head" rel="preload" as="image" href="/media/tea/sachet-v3.webp" type="image/webp" fetchpriority="high" />
  <AmbientShader ripple />
  <section class="page">
    <h1 class="page-title">Contact</h1>
    <TeaContact items={teas} />
    {site.links.cv && <p class="cv"><a class="ul" href={site.links.cv}>CV</a></p>}
  </section>
</Base>

<style>
  .cv { margin: clamp(32px, 4vw, 48px) 0 0; font-size: var(--fs-l); }
</style>
