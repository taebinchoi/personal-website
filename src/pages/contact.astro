---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// show: 옆에 보여 줄 주소
const links = [
  { label: 'Email', href: site.links.email, show: site.links.email.replace('mailto:', ''), copy: true },
  { label: 'Instagram', href: site.links.instagram, show: '@' + site.links.instagram.split('/').filter(Boolean).pop() },
  { label: 'GitHub', href: site.links.github, show: site.links.github.replace('https://', '') },
  { label: 'CV', href: site.links.cv, show: 'PDF' },
].filter((l) => l.href);
---
<Base title="Contact">
  <section class="page">
    <h1 class="page-title">Contact</h1>
    <ul class="list">
      {links.map((l) => (
        <li>
          <a href={l.href} data-copy={l.copy ? l.show : undefined} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="label">{l.label}</span>
            <span class="addr" aria-live="polite">{l.show}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // Email은 누르면 주소가 복사돼요. 복사가 안 되는 환경에서는 원래대로 메일 앱이 열려요.
  document.querySelectorAll<HTMLAnchorElement>('a[data-copy]').forEach((a) => {
    a.addEventListener('click', async (e) => {
      const text = a.dataset.copy!;
      const addr = a.querySelector<HTMLElement>('.addr')!;
      try {
        e.preventDefault();
        await navigator.clipboard.writeText(text);
        addr.textContent = 'Copied';
        a.classList.add('copied');
        setTimeout(() => { addr.textContent = text; a.classList.remove('copied'); }, 1600);
      } catch {
        location.href = a.href;
      }
    }, true);
  });
</script>

<style>
  .list { list-style: none; margin: clamp(24px, 3vw, 36px) 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  a { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 4px 24px; text-decoration: none; }
  .label {
    font-size: var(--fs-xl); line-height: 1.1;
    background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat;
    background-position: 0 100%; background-size: 0% 2px; transition: background-size .4s var(--ease);
  }
  .addr { font-size: var(--fs-lead); color: var(--fg-3); }
  a.copied .addr { color: var(--fg); clip-path: none !important; }

  /* 마우스가 있는 화면: 올리면 주소가 쓸리듯 나타나요 */
  @media (hover: hover) {
    .addr { clip-path: inset(0 100% 0 0); transition: clip-path .55s var(--ease-io); }
    a:hover .addr, a:focus-visible .addr { clip-path: inset(0 0 -20% 0); }
    a:hover .label, a:focus-visible .label { background-size: 100% 2px; }
  }
  /* 폰: 주소를 항상 이름 아래에 작게 */
  @media (hover: none) {
    a { flex-direction: column; gap: 2px; }
    .list { gap: 20px; }
  }
</style>
