---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const links = [
  { label: 'Email', href: site.links.email },
  { label: 'Instagram', href: site.links.instagram },
  { label: 'GitHub', href: site.links.github },
  { label: 'CV', href: site.links.cv },
].filter((l) => l.href);
---
<Base title="Contact">
  <section class="page wrap">
    <h1 class="page-title">Contact</h1>
    <ul>
      {links.map((l) => <li><a class="ul" href={l.href}>{l.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .wrap { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 48px); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  a { font-size: var(--fs-xl); line-height: 1.1; }
</style>
