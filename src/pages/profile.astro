---
import Base from '../layouts/Base.astro';
import Alternate from '../components/Alternate.astro';

// 프로필 내용은 여기서 고쳐요.
const intro = '기술과 예술의 융합과 적용을 이해하고 이를 기반으로 한 다양한 결과물을 창작하고, Human-Computer Interaction(HCI)에 관해 연구하고자 합니다.';
// 한 열(column) 안에 여러 묶음을 위아래로 쌓을 수 있어요.
const columns = [
  [
    { title: 'Education', lines: ['European Language & Culture (Français)', '@ Sogang Univ.'] },
    { title: 'Certificates', lines: ['ADsP', 'SQLD'] },
    { title: 'Languages', lines: ['한국어', 'English', '中文', 'Français'] },
  ],
  [
    { title: 'Tools', lines: ['Pandas / NumPy / Gephi', 'TouchDesigner', 'Cinema 4D', 'Web (JS)'] },
  ],
  [
    { title: 'Now', lines: ['Planning an additional major in Art & Technology', 'Developing projects in various forms and directions', 'Planning AI-related academic activities'] },
    // 활동·수상 이력이 생기면 여기에 한 줄씩 추가하세요. 비어 있으면 사이트에 나오지 않아요.
    // 예: '2026  [전시/공모전 이름], [기관]'
    { title: 'Activities', lines: [] },
  ],
];
const languages = {
  ko: '한국어, 영어, 그리고 간단한 중국어와 프랑스어를 통한 <br>협업 제안 및 피드백에 응답 및 소통 가능합니다.',
  en: 'I can respond to and communicate collaboration proposals and feedback <br>in Korean, English, and basic Chinese and French.',
};
---
<Base title="Profile">
  <section class="page">
    <h1 class="page-title">Profile</h1>
    <p class="page-intro lead rise"><span style="animation-delay:.45s">{intro}</span></p>
    <div class="page-body grid">
      {columns.map((col) => (
        <div class="col">
          {col.filter((b) => b.lines.length > 0).map((b) => (
            <div>
              <h2>{b.title}</h2>
              <ul>{b.lines.map((l) => <li>{l}</li>)}</ul>
            </div>
          ))}
        </div>
      ))}
    </div>
    <p class="langs"><Alternate ko={languages.ko} en={languages.en} /></p>
  </section>
</Base>

<style>
  .lead { font-size: clamp(21px, 2.2vw, 30px); line-height: 1.5; max-width: 860px; color: var(--fg); text-wrap: pretty; }
  .grid { display: grid; gap: 36px 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .col { display: flex; flex-direction: column; gap: 36px; }
  h2 { font-weight: 700; font-size: clamp(20px, 1.9vw, 26px); margin-bottom: 12px; }
  .grid ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; color: var(--fg-2); line-height: 1.55; font-size: var(--fs-lead); }
  .langs { margin-top: clamp(48px, 6vw, 72px); color: var(--fg-2); font-size: var(--fs-lead); line-height: 1.7; max-width: 760px; }
</style>
