---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Alternate from '../../components/Alternate.astro';
import ProjectItem from '../../components/ProjectItem.astro';

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const ids = new Set(topics.map((t) => t.id));
const inTopic = (id: string) => notes.filter((n) => n.data.topic === id);
const loose = notes.filter((n) => !n.data.topic || !ids.has(n.data.topic)); // 주제가 없는 노트
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base title="Notes">
  <section class="page">
    <h1 class="page-title">Notes</h1>
    <div class="intro-row">
    <p class="page-intro rise"><span style="animation-delay:.45s">
        <Alternate
          ko="Human-Computer Interaction(HCI)를 포함해 여러 학술적 내용 및 <br>리서치 기록을 정리하기 위한 장소입니다."
          en="This is a place for organizing various academic content <br>and research records, including Human-Computer Interaction (HCI)."
        />
      </span></p>
      <div class="lang-switch" role="group" aria-label="Language">
        <button type="button" data-set="ko" aria-pressed="true"><span class="when-ko">한국어</span><span class="when-en">Korean</span></button>
        <span aria-hidden="true">/</span>
        <button type="button" data-set="en" aria-pressed="false"><span class="when-ko">영어</span><span class="when-en">English</span></button>
      </div>
    </div>
    <div class="page-body topics">
      {topics.map((t) => {
        const list = inTopic(t.id);
        return (
          <ProjectItem project={t} base="/notes" count={list.length} langSwitch={false}>
            {list.length > 0 && (
              <ul class="in-topic">
                {list.map((n) => (
                  <li>
                    <a class="ul" href={`/notes/${n.id}`}>{n.data.title}</a>
                    <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
                  </li>
                ))}
              </ul>
            )}
          </ProjectItem>
        );
      })}
    </div>
    {loose.length > 0 && (
      <ul class="loose">
        {loose.map((n) => (
          <li>
            <a href={`/notes/${n.id}`}>
              <span class="t">{n.data.title}</span>
              <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
            </a>
            {n.data.summary && <p>{n.data.summary}</p>}
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .intro-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 16px 32px; }
  .lang-switch { display: flex; align-items: center; gap: 8px; font-size: var(--fs-s); color: var(--fg-4); }
  .lang-switch button { all: unset; cursor: pointer; padding: 8px 0; min-height: 32px; display: inline-flex; align-items: center; }
  .lang-switch button:hover { color: var(--fg-2); }
  .lang-switch button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .lang-switch button[aria-pressed='true'] { color: var(--fg); font-weight: 700; }
  .topics { display: flex; flex-direction: column; gap: clamp(40px, 5vw, 64px); }
  /* 주제 안의 노트 목록 */
  .in-topic { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .in-topic li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 24px; align-items: baseline; }
  .in-topic a { color: var(--fg); }
  .loose { list-style: none; margin: clamp(80px, 11vw, 120px) 0 0; padding: 0; display: flex; flex-direction: column; gap: 40px; }
  .loose li a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 24px; align-items: baseline; text-decoration: none; }
  .t { font-weight: 700; font-size: var(--fs-xl); line-height: 1.1; color: var(--fg); }
  @supports (animation-timeline: view()) {
    .t {
      color: transparent; -webkit-text-stroke: 1px var(--fg);
      animation: fill linear both; animation-timeline: view(); animation-range: entry 20% cover 45%;
    }
  }
  @keyframes fill { from { color: transparent; } to { color: var(--fg); } }
  time { font-size: var(--fs-s); color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .loose li p { margin-top: 10px; color: var(--fg-2); max-width: 640px; }
  @media (max-width: 599px) { .loose li a { grid-template-columns: 1fr; } }
</style>
