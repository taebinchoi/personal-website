---
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Alternate from '../components/Alternate.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// 첫 작업의 정지 이미지를 가장 먼저 받아서 첫 화면이 빨리 뜨게
const firstPoster = projects[0]?.data.video?.poster;
---
<Base>
  {firstPoster && <link slot="head" rel="preload" as="image" href={firstPoster} fetchpriority="high" />}
  <section class="page">
    <h1 class="page-title">Portfolio</h1>
    <p class="page-intro rise"><span style="animation-delay:.45s">
      <Alternate
        ko="기록 영상과 이미지로 정리한 작업들입니다."
        en="These are works organized into <br>archival videos and images, etc."
      />
    </span></p>
    <div class="page-body list">
      {projects.map((p) => <ProjectItem project={p} />)}
    </div>
  </section>
</Base>

<style>
  .list { display: flex; flex-direction: column; gap: clamp(80px, 11vw, 120px); }
</style>
