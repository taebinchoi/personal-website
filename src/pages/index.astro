---
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Alternate from '../components/Alternate.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="page">
    <h1 class="page-title">Portfolio</h1>
    <p class="intro rise"><span style="animation-delay:.45s">
      <Alternate
        ko="기록 영상과 이미지로 정리한 작업들입니다."
        en="These are works organized into <br>archival videos and images, etc."
      />
    </span></p>
    <div class="list">
      {projects.map((p) => <ProjectItem project={p} />)}
    </div>
  </section>
</Base>

<style>
  .intro { margin: 32px 0 clamp(64px, 9vw, 96px); max-width: 560px; color: var(--fg-2); font-size: var(--fs-lead); line-height: 1.6; }
  .list { display: flex; flex-direction: column; gap: clamp(80px, 11vw, 120px); }
</style>
