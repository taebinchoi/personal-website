---
// 첫 화면(taebinchoi.com)은 Profile로 이동해요.
// Cloudflare에서는 public/_redirects 가 먼저 처리하고, 이 페이지는 그게 안 될 때를 위한 예비예요.
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://taebinchoi.com/profile" />
  <script is:inline>location.replace('/profile' + location.hash);</script>
  <noscript><meta http-equiv="refresh" content="0;url=/profile" /></noscript>
  <title>Taebin Choi</title>
</head>
<body><a href="/profile">Profile</a></body>
</html>
