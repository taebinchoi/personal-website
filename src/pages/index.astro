---
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="page">
    <h1 class="page-title">Portfolio</h1>
    <p class="intro">
      <span class="rise"><span style="animation-delay:.45s">기록 영상과 이미지로 정리한</span></span>
      <span class="rise"><span style="animation-delay:.55s">작업들입니다.</span></span>
    </p>
    <div class="list">
      {projects.map((p) => <ProjectItem project={p} />)}
    </div>
  </section>
</Base>

<style>
  .intro { margin: 32px 0 clamp(64px, 9vw, 96px); max-width: 480px; color: var(--fg-2); }
  .list { display: flex; flex-direction: column; gap: clamp(80px, 11vw, 120px); }
</style>
